# build artifacts
bin/
*.exe
*.test
*.out

# coverage
coverage.txt
*.coverprofile

# data files generated by runs
*.db
subs/
all-results.csv
raw/

# in case dev runs the binary from $HOME
.xray-knife/

# editors
.idea/
.vscode/
*.swp
.DS_Store

# os
Thumbs.db
configs.txt
valid.txt

# local-only scratch (probe outputs, ad-hoc scripts) — but keep
# sources-fetched/ tracked because the workflow refreshes converted
# subscription files into it (e.g. paiyt.txt from sing-box JSON).
dev/*
!dev/sources-fetched/
.bench/
.kiro/
scripts/logs/

# README sidecar JSONs written by per-protocol matrix jobs and read back
# by the merge job's regen-readme step. Transient artifacts, not commit-worthy.
.readme-data/


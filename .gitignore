# build artifacts
bin/
*.exe
*.test
*.out

# coverage
coverage.txt
*.coverprofile

# data files generated by runs
*.db
subs/
all-results.csv
raw/

# in case dev runs the binary from $HOME
.xray-knife/

# editors
.idea/
.vscode/
*.swp
.DS_Store

# os
Thumbs.db
desktop.ini
configs.txt
valid.txt

# local scratch: API-client workspaces, pasted screenshots, ad-hoc diffs
.postman*/
postman*/
*.png
diff_output.txt

# local-only scratch (probe outputs, ad-hoc scripts) — but keep
# sources-fetched/ tracked because the workflow commits converted subscription
# files into it (e.g. paiyt.txt from sing-box JSON). NOTE: "refreshes" was
# aspirational — paiyt.txt has not changed since 2026-05-30 because sub.pai.yt
# is down; see the STATUS note on sub-paiyt-converted in sources.yaml.
dev/*
!dev/sources-fetched/

# benchmark.yml writes bench/ (no dot); .bench/ was a local-only convention.
# Both ignored so a local sweep does not show up as untracked noise.
.bench/
bench/
.kiro/
scripts/logs/

# README sidecar JSONs written by per-protocol matrix jobs and read back
# by the merge job's regen-readme step. Transient artifacts, not commit-worthy.
.readme-data/

